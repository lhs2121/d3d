<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <EngineRoot>$(MSBuildThisFileDirectory)..\</EngineRoot>
    <EngineOutputDir>$(EngineRoot)bin\$(Platform)\$(Configuration)\</EngineOutputDir>
  </PropertyGroup>

  <PropertyGroup>
    <OutDir>$(EngineOutputDir)</OutDir>
    <IntDir>$(EngineOutputDir)$(ProjectName)\</IntDir>
    <IncludePath>$(EngineRoot);$(IncludePath)</IncludePath>
    <LibraryPath>$(EngineOutputDir);$(LibraryPath)</LibraryPath>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
